# 환경변수 설정 예시
# 이 파일을 복사해서 .env 파일을 만들고 실제 키를 입력하세요

# Groq API 키
# 발급: https://console.groq.com → API Keys
VITE_GROQ_API_KEY=YOUR_GROQ_API_KEY

# NEIS 교육정보시스템 API 키 (전국 학교 검색용)
# 발급: https://open.neis.go.kr → 인증키 신청 (무료)
# 이 키가 없으면 제한된 검색만 가능합니다
VITE_NEIS_API_KEY=YOUR_NEIS_API_KEY

# 학교알리미 Open API 키 (상세 학생수 현황용)
# 발급: https://www.schoolinfo.go.kr → OpenAPI → 인증키 발급
VITE_SCHOOLINFO_API_KEY=YOUR_SCHOOLINFO_API_KEY

# Supabase 설정
# 발급: https://supabase.com → 프로젝트 → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 카카오 JavaScript 키 — 카카오맵(전국 폐교 지도)과 카카오 로그인(학교별 댓글) 둘 다 이 키를 공유해서 씀
# 발급: https://developers.kakao.com → 내 애플리케이션 → 플랫폼 키 → JavaScript 키
# - 지도용: 플랫폼 키 > JavaScript 키 > "JavaScript SDK 도메인"에 배포 도메인 등록 필요
# - 로그인용: 제품 설정 > 카카오 로그인 활성화 ON + Redirect URI에 배포 도메인 등록 필요
#   (동의항목에서 닉네임 · 프로필 사진 항목도 켜야 함)
VITE_KAKAO_JS_KEY=YOUR_KAKAO_JS_KEY
